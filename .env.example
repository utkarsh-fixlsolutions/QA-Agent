# Copy this file to .env and fill in real values locally - .env itself is
# git-ignored and never read automatically by QA-Agent (no dotenv loading
# anywhere in this project); this file exists purely as a documented
# reminder of which environment variable to set in your own shell/session.
#
# Required only when using the optional OpenRouter cloud provider
# (--ai-provider cloud / ai.provider: "cloud" - docs/27-openrouter-cloud-provider.md).
# Never required for local Ollama use, MockProvider, or any deterministic
# QA functionality.
OPENROUTER_API_KEY=
